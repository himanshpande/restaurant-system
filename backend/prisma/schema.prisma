generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
}

model Table {
  id          Int      @id @default(autoincrement())
  tableNumber Int      @unique
  token       String   @unique
  status      String   @default("AVAILABLE")
  createdAt   DateTime @default(now())
}